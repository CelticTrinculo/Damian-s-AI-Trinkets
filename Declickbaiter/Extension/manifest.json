{
    "manifest_version": 3,
    "name": "DeClickbait Assistant",
    "version": "1.0",
    "description": "Summarize clickbait articles directly from your browser using OpenAI's GPT.",
    "permissions": ["activeTab", "scripting"],
    "host_permissions": ["<all_urls>"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "512": "icons/icon512.png"
      }
    },
    "icons": {
      "512": "icons/icon512.png"
    }
  }
  